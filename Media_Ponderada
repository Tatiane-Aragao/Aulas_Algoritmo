programa {
  funcao inicio() 
  {
     real m1, m2, m3, p1, p2, p3, media_ponderada

    escreva ("Informe a nota 1: ")
    leia (m1)
    escreva ("Informe P1: ")
    leia (p1)
    escreva ("Informe a nota 2: ")
    leia (m2)
    escreva ("Informe P2: ")
    leia (p2)
    escreva ("Informe a nota 3: ")
    leia (m3)
    escreva ("Informe P3: ")
    leia (p3)

    media_ponderada = ((m1*p1 + m2*p2 + m3*p3) / (p1 + p2 + p3))
    se(media_ponderada  < 9.5)
      {
      escreva (" Seu resultado é: INSUFICIENTE\n", "Nota media:", media_ponderada)
      }
    senao se(media_ponderada >= 9.5 e media_ponderada <= 14)
      {
      escreva (" Seu resultado é: SUFICIENTE\n", "Nota media:", media_ponderada)
      }
    senao
      {
      escreva ("Seu resultado é: BOM\n", "Nota media:", media_ponderada)
      }
  }
}